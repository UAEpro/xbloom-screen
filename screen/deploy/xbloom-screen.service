# xBloom Screen — touchscreen controller for the xBloom Studio coffee machine.
#
# Runs full-screen on the Pi's display straight from DRM/KMS (no desktop needed), talks to
# the machine over Bluetooth (BlueZ) and serves the admin panel on port 80.
# Installed by screen/deploy/install.sh.

[Unit]
Description=xBloom Screen
After=bluetooth.target network-online.target systemd-user-sessions.service
Wants=bluetooth.target network-online.target
# The screen owns the display: no login prompt flashing on tty1.
Conflicts=getty@tty1.service

[Service]
Type=simple
User=xbloom
Group=xbloom
SupplementaryGroups=video render input bluetooth
StateDirectory=xbloom-screen
StateDirectoryMode=0700
Environment=SLINT_BACKEND=linuxkms-software
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/xbloom-screen --port 80
# Port 80 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2

# Hardening. /dev (display, input) and /sys (backlight) stay reachable; the rest is read-only.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
