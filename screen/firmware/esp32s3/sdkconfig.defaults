# xBloom Screen — ESP-IDF configuration for ESP32-S3 boards with an RGB panel
# (16 MB flash, 8 MB octal PSRAM).

# --- CPU, flash --------------------------------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# ESP-IDF's C code optimized for size (the Rust side has its own profile).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- Console -------------------------------------------------------------------------------
# Log on the chip's own USB (the port used for flashing). On some boards the UART Type-C port
# isn't wired to UART0, so the default UART console prints nowhere.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- PSRAM ---------------------------------------------------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Plain malloc() goes to PSRAM first. Slint allocates a 16-byte node for every property a binding
# reads, thousands of them, and with the default threshold they used up internal RAM (demo mode
# crashed). Code that needs internal or DMA memory asks for it explicitly. Keep 64 KB of internal
# RAM for DMA / Wi-Fi / BLE.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# Run code and constants from PSRAM: flash writes (saving settings, uploads) then don't stall
# the display, and thread stacks may live in PSRAM.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# --- Caches (Espressif's recommendation for RGB panels) -------------------------------------
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# --- Tasks ---------------------------------------------------------------------------------
# The main task only starts the UI thread (its stack is in PSRAM, see main.rs); internal RAM is
# kept for Wi-Fi and Bluetooth.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# --- Display -------------------------------------------------------------------------------
# Recover automatically if the RGB stream ever drifts.
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# --- Bluetooth: NimBLE, central only (talks to one machine) ----------------------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_NVS_PERSIST=n

# --- Networking ----------------------------------------------------------------------------
CONFIG_LWIP_MAX_SOCKETS=16
# Browsers send long headers (cookies, user agent).
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024

# --- Data partition (FAT) ------------------------------------------------------------------
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_WL_SECTOR_SIZE_4096=y
