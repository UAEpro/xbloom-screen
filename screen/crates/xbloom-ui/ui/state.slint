    out property <image> check-circle: @image-url("icons/circle-check.svg");
    out property <image> x-circle: @image-url("icons/circle-x.svg");
    out property <image> play: @image-url("icons/play.svg");
    out property <image> droplet: @image-url("icons/droplet.svg");
    out property <image> thermometer: @image-url("icons/thermometer.svg");
