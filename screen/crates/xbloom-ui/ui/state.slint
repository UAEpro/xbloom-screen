    out property <image> moon: @image-url("icons/moon.svg");
    out property <image> sun-moon: @image-url("icons/sun-moon.svg");
    out property <image> image: @image-url("icons/image.svg");
    out property <image> film: @image-url("icons/film.svg");
    out property <image> qr: @image-url("icons/qr-code.svg");
    out property <image> info: @image-url("icons/info.svg");
    out property <image> snowflake: @image-url("icons/snowflake.svg");
    out property <image> bean: @image-url("icons/bean.svg");
    out property <image> flame: @image-url("icons/flame.svg");
    out property <image> backspace: @image-url("icons/delete.svg");
    out property <image> clock: @image-url("icons/clock.svg");
    out property <image> monitor: @image-url("icons/monitor.svg");
    out property <image> hand: @image-url("icons/hand.svg");
    out property <image> shield: @image-url("icons/shield-check.svg");
    out property <image> sparkles: @image-url("icons/sparkles.svg");
    out property <image> gauge: @image-url("icons/gauge.svg");
    out property <image> scale: @image-url("icons/scale.svg");
    out property <image> leaf: @image-url("icons/leaf.svg");
    out property <image> alarm: @image-url("icons/alarm-clock.svg");
    out property <image> alarm-on: @image-url("icons/alarm-clock-check.svg");
    out property <image> alarm-off: @image-url("icons/alarm-clock-off.svg");
    out property <image> rinse: @image-url("icons/droplets.svg");
