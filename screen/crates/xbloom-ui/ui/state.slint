// The contract between the Rust app and the UI: data structs, the AppState global
// (properties Rust fills in, callbacks Rust implements), and the icon set.

export enum Page { home, recipe, brewing, history, presets, settings, setup }
export enum LinkState { disconnected, connecting, connected }
export enum Overlay { none, pin, cancel-brew, pick-recipe, machine, confirm }

export struct PourInfo {
    label: string,
    ml: int,
    temp: int,
    pattern: string,
    pause: int,
    agitation: bool,
    share: float,     // ml / total, for the pour timeline
}

export struct RecipeCard {
    id: string,
    name: string,
    subtitle: string,  // "Omni · custom"
    kind: string,      // "filter" | "iced" | "no-grind"
    dose: int,
    ratio: string,     // "1:15"
    ratio-value: float,
    grind: string,     // "62" or "—"
    water: int,
    time: string,      // "~2:30"
    temp: string,      // "93°"
    note: string,
    favorite: bool,
    tint: color,
    brews: int,
    pours: [PourInfo],
}

export struct BrewInfo {
    active: bool,      // a brew session exists (running or finished)
    finished: bool,
    success: bool,
    error: bool,
    remote: bool,
    stage: string,     // connecting | loading | starting | armed | awaiting_confirm | grinding | brewing | drawdown | finished
    message: string,
    recipe: string,
    water: float,
    coffee: float,
    target: float,
    progress: float,
    elapsed: string,   // "1:24"
    stage-index: int,
    stages: [string],
    outcome: string,
}

export struct HistoryRow { id: string, title: string, when: string, detail: string, success: bool }
export struct SlotRow { slot: string, recipe-id: string, recipe: string, detail: string, scale: bool }
export struct ScanRow { address: string, name: string, signal: string }
export struct MediaRow { name: string, detail: string, video: bool }
export struct ToastInfo { message: string, kind: string, visible: bool }

export global AppState {
    // ── navigation ──
    in-out property <Page> page: Page.home;
    in-out property <Overlay> overlay: Overlay.none;
    in-out property <int> settings-tab: 0;

    // ── chrome / clock ──
    in property <string> device-name: "xBloom Screen";
    in property <string> time: "08:42";
    in property <string> date: "Saturday 17 October";
    in property <string> greeting: "Good morning";

    // ── machine ──
    in property <LinkState> link: LinkState.disconnected;
    in property <string> machine-name: "No machine";
    in property <string> machine-detail: "";
    in property <bool> simulator: false;
    in property <bool> paired: false;
    in property <bool> scanning: false;
    in property <[ScanRow]> scan-results: [];
    in property <string> machine-busy: "";

    // ── recipes ──
    in property <[RecipeCard]> recipes: [];
    in-out property <RecipeCard> current;
    in-out property <int> brew-dose: 16;

    // ── brew ──
    in property <BrewInfo> brew;
    in property <string> chart-water: "";     // SVG path commands, viewbox 1000 × 400
    in property <string> chart-coffee: "";
    in property <float> chart-target-y: 0.2;   // target water line, 0–1 from the top

    // ── history ──
    in property <[HistoryRow]> history: [];
    in-out property <int> history-selected: 0;
    in property <string> history-title: "";
    in property <string> history-detail: "";
    in property <string> history-water: "";
    in property <string> history-coffee: "";

    // ── dial presets ──
    in property <[SlotRow]> slots: [];
    in property <bool> slots-dirty: false;
    in property <string> slots-status: "";
    in-out property <int> picking-slot: -1;

    // ── lock / PIN pad ──
    in property <bool> locked: false;
    in property <int> lock-mode: 0;            // 0 off · 1 brew needs PIN · 2 screen lock
    in property <bool> brew-needs-pin: false;
    in property <string> pin-title: "Enter PIN";
    in property <string> pin-subtitle: "";
    in property <string> pin-error: "";
    in property <int> pin-length: 0;          // digits typed (the PIN itself stays in Rust)

    // ── screensaver ──
    in property <bool> saver-active: false;
    in property <int> saver-mode: 1;           // 0 off · 1 clock · 2 video · 3 photos
    in property <image> saver-frame;
    in property <bool> saver-has-frame: false;
    in property <bool> saver-clock-overlay: true;
    in property <bool> asleep: false;

    // ── settings mirrors ──
    in property <int> theme-mode: 0;           // 0 light · 1 dark · 2 auto
    in property <int> brightness: 80;
    in property <bool> clock-24h: true;
    in property <bool> allow-remote-start: true;
    in property <int> hold-ms: 1200;
    in property <int> saver-idle-min: 2;
    in property <string> saver-video: "";
    in property <[MediaRow]> media: [];
    in property <int> auto-lock-min: 5;
    in property <bool> auto-connect: true;
    in property <bool> has-user-pin: false;
    in property <image> admin-qr;
    in property <string> admin-url: "";
    // Set while the device hosts its own setup Wi-Fi: how to join it (the QR then joins it).
    in property <string> admin-hint: "";
    in property <string> version: "";
    in property <string> platform: "";
    in property <string> storage: "";
    in property <int> recipe-count: 0;
    in property <int> brew-count: 0;

    // ── first-run setup ──
    in property <bool> needs-setup: false;
    in-out property <int> setup-step: 0;

    // ── toast ──
    in property <ToastInfo> toast;

    // ── callbacks (implemented in Rust) ──
    callback activity();
    callback wake();
    callback navigate(Page);
    callback open-recipe(string);
    callback toggle-favorite(string);
    callback start-brew(bool);           // true = remote start (hold-to-brew), false = load only
    callback cancel-brew();
    callback brew-dismiss();
    callback pin-key(string);            // "0"–"9", "del", "ok"
    callback pin-cancel();
    callback lock-now();
    callback connect();
    callback disconnect();
    callback scan();
    callback pair(string);
    callback forget();
    callback set-theme(int);
    callback set-accent(color);
    callback set-brightness(int);
    callback set-clock-24h(bool);
    callback set-saver-mode(int);
    callback set-saver-idle(int);
    callback set-saver-video(string);
    callback set-saver-clock(bool);
    callback set-lock-mode(int);
    callback set-auto-lock(int);
    callback set-remote-start(bool);
    callback set-hold-ms(int);
    callback set-auto-connect(bool);
    callback set-simulator(bool);
    callback change-admin-pin();
    callback set-user-pin();
    callback clear-user-pin();
    callback assign-slot(int, string);
    callback set-slot-scale(int, bool);
    callback push-presets();
    callback select-history(int);
    callback setup-start();
    callback setup-demo();
    callback setup-finish();
    callback restart();
}

