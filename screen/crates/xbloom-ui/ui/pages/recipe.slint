// Recipe detail = the brew confirmation. Shows what will be brewed, lets you adjust the dose
// (same ratio), then brew: HOLD to start remotely (the deliberate gesture for hot water) or
// "Load only" so the machine arms and you approve on the machine.
//
// Landscape: details and the brew panel side by side. Portrait / square: details scroll above
// a brew panel pinned to the bottom, so the brew controls are always on screen.

import { Theme } from "../theme.slint";
import { Layout } from "../layout.slint";
import { AppState, Icons, Page, PourInfo, LinkState } from "../state.slint";
import { Icon, Chip, Card, Button, ButtonKind, HoldButton, IconButton, StatTile, SectionTitle } from "../widgets.slint";
import { Header } from "../chrome.slint";

component PourRow inherits Rectangle {
    in property <PourInfo> pour;
    in property <int> index;
    // Narrow rows put the temperature / pattern under the label.
    in property <bool> two-line;
    property <string> meta: root.pour.temp + "° · " + root.pour.pattern + (root.pour.pause > 0 ? " · " + root.pour.pause + " s" : "");
    height: two-line ? 54px : 46px;
    HorizontalLayout {
        spacing: Layout.compact ? 10px : 12px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: Theme.accent-soft;
            Text {
                text: root.index + 1;
                color: Theme.accent-strong;
                font-size: Theme.fs-small;
                font-weight: 700;
            }
        }
        if !root.two-line: Text {
            width: 110px;
            text: root.pour.label;
            color: Theme.text;
            font-size: Theme.fs-body;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.two-line: VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.pour.label;
                color: Theme.text;
                font-size: Theme.fs-body;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.meta;
                color: Theme.text-2;
                font-size: Theme.fs-caption;
                overflow: elide;
            }
        }
        if !root.two-line: Rectangle { horizontal-stretch: 1; }
        Text {
            width: 56px;
            text: root.pour.ml + " ml";
            color: Theme.text;
            font-size: Theme.fs-small;
            font-weight: 700;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        if !root.two-line: Text {
            width: 112px;
            text: root.meta;
            color: Theme.text-2;
            font-size: Theme.fs-caption;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

// What you'll brew: dose, ratio, grind, water, then the pours. Scrolls when it doesn't fit.
component Details inherits Card {
    in property <int> water;
    // The card's width, computed by the page (the card can't measure itself: its content
    // scrolls).
    in property <length> pane-width;
    // Four stat tiles in a row need about 360 px; otherwise two by two.
    property <bool> wide-stats: pane-width >= 380px;
    property <bool> tea: AppState.current.kind == "tea";
    // Coffee: dose, ratio, grind, water. Tea (grinder off): water, temperature, pours, time.
    property <string> v1: tea ? root.water : AppState.brew-dose;
    property <string> v2: tea ? AppState.current.temp : AppState.current.ratio;
    property <string> v3: tea ? AppState.current.pours.length : AppState.current.grind;
    property <string> v4: tea ? AppState.current.time : root.water;
    property <bool> two-line-pours: pane-width - 2 * Layout.card-pad < 340px;
    Flickable {
        content-width: self.width;
        content-height: col.preferred-height;
        flicked => { AppState.activity(); }
        col := VerticalLayout {
            width: parent.width;
            padding: Layout.card-pad;
            spacing: Layout.compact ? 10px : 14px;
            if root.wide-stats: HorizontalLayout {
                spacing: 8px;
                StatTile { icon: root.tea ? Icons.droplet : Icons.weight; label: root.tea ? "WATER" : "DOSE"; value: root.v1; unit: root.tea ? "ml" : "g"; }
                StatTile { icon: root.tea ? Icons.thermometer : Icons.scale; label: root.tea ? "TEMP" : "RATIO"; value: root.v2; unit: ""; }
                StatTile { icon: root.tea ? Icons.leaf : Icons.gauge; label: root.tea ? "POURS" : "GRIND"; value: root.v3; unit: ""; }
                StatTile { icon: root.tea ? Icons.timer : Icons.droplet; label: root.tea ? "TIME" : "WATER"; value: root.v4; unit: root.tea ? "" : "ml"; }
            }
            if !root.wide-stats: GridLayout {
                spacing: 8px;
                Row {
                    StatTile { icon: root.tea ? Icons.droplet : Icons.weight; label: root.tea ? "WATER" : "DOSE"; value: root.v1; unit: root.tea ? "ml" : "g"; }
                    StatTile { icon: root.tea ? Icons.thermometer : Icons.scale; label: root.tea ? "TEMP" : "RATIO"; value: root.v2; unit: ""; }
                }
                Row {
                    StatTile { icon: root.tea ? Icons.leaf : Icons.gauge; label: root.tea ? "POURS" : "GRIND"; value: root.v3; unit: ""; }
                    StatTile { icon: root.tea ? Icons.timer : Icons.droplet; label: root.tea ? "TIME" : "WATER"; value: root.v4; unit: root.tea ? "" : "ml"; }
                }
            }
            HorizontalLayout {
                SectionTitle { text: "POURS"; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                if AppState.current.time != "": Chip { has-icon: true; icon: Icons.timer; text: AppState.current.time; }
            }
            HorizontalLayout {
                spacing: 3px;
                height: 10px;
                for p in AppState.current.pours: Rectangle {
                    horizontal-stretch: max(0.05, p.share);
                    border-radius: 5px;
                    background: Theme.water.transparentize(0.3);
                }
            }
            VerticalLayout {
                for p[i] in AppState.current.pours: PourRow {
                    pour: p;
                    index: i;
                    two-line: root.two-line-pours;
                }
            }
            if AppState.current.note != "": Text {
                text: AppState.current.note;
                color: Theme.text-2;
                font-size: Theme.fs-small;
                wrap: word-wrap;
            }
        }
    }
}

// Dose stepper and the brew buttons.
component BrewPanel inherits Card {
    in property <int> water;
    in property <bool> busy;
    // Short screens show only the controls (and the status when it's a warning).
    property <bool> slim: Layout.short;
    property <bool> warn: root.busy || (AppState.link != LinkState.connected && !AppState.simulator);
    property <length> step-size: Layout.compact ? 40px : 48px;
    // Tea: the stepper sizes the cup (the "dose" only keeps the ratio; the grinder is off).
    property <bool> tea: AppState.current.kind == "tea";
    VerticalLayout {
        padding: Layout.card-pad;
        spacing: root.slim ? 8px : Layout.compact ? 10px : 14px;
        if !root.slim: SectionTitle { text: root.tea ? "CUP SIZE" : "STRENGTH & SIZE"; }
        HorizontalLayout {
            spacing: 10px;
            IconButton {
                size: root.step-size;
                icon: Icons.minus;
                enabled: AppState.brew-dose > 5;
                clicked => { AppState.brew-dose = AppState.brew-dose - 1; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: root.tea ? root.water + " ml" : AppState.brew-dose + " g";
                    color: Theme.text;
                    font-size: Theme.fs-title;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.tea ? "grinder off" : root.water + " ml water";
                    color: Theme.text-2;
                    font-size: Theme.fs-caption;
                    horizontal-alignment: center;
                }
            }
            IconButton {
                size: root.step-size;
                icon: Icons.plus;
                enabled: AppState.brew-dose < 18;
                clicked => { AppState.brew-dose = AppState.brew-dose + 1; }
            }
        }
        if !Layout.stack: Rectangle { vertical-stretch: 1; }
        if !root.slim || root.warn: Text {
            text: root.busy ? "A brew is already running." : AppState.link != LinkState.connected && !AppState.simulator ? "The machine is offline — it will connect when you brew." : root.tea ? "Leaves in the filter, cup in place, tank filled?" : "Beans in, cup in place, tank filled?";
            color: root.warn ? Theme.warning : Theme.text-2;
            font-size: root.slim ? Theme.fs-caption : Theme.fs-small;
            wrap: root.slim ? no-wrap : word-wrap;
            overflow: elide;
            horizontal-alignment: center;
        }
        if AppState.allow-remote-start: HoldButton {
            height: Layout.compact ? 54px : 64px;
            text: "Hold to brew";
            locked: AppState.brew-needs-pin;
            hold-ms: AppState.hold-ms;
            enabled: !root.busy;
            activated => { AppState.start-brew(true); }
        }
        Button {
            min-height: Layout.compact ? 44px : 52px;
            text: AppState.allow-remote-start ? "Load only" : "Send to machine";
            has-icon: true;
            icon: Icons.hand;
            kind: AppState.allow-remote-start ? ButtonKind.outline : ButtonKind.primary;
            enabled: !root.busy;
            clicked => { AppState.start-brew(false); }
        }
        if !root.slim && !Layout.compact: Text {
            text: AppState.allow-remote-start ? "Load only: the machine arms, you press start on it." : "The machine arms; press start on the machine.";
            color: Theme.text-3;
            font-size: Theme.fs-caption;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}

export component RecipePage inherits Rectangle {
    property <int> water: round(AppState.brew-dose * AppState.current.ratio-value);
    property <bool> busy: AppState.brew.active && !AppState.brew.finished;
    property <length> panel-w: Layout.compact ? 200px : Layout.large ? 300px : 252px;
    property <length> details-w: Layout.stack ? Layout.inner-width : Layout.inner-width - Layout.gap - panel-w;

    VerticalLayout {
        Header {
            show-back: true;
            title: AppState.current.name;
            subtitle: AppState.current.subtitle;
            back => { AppState.navigate(Page.home); }
        }
        if !Layout.stack: HorizontalLayout {
            vertical-stretch: 1;
            padding-left: Layout.pad-left;
            padding-right: Layout.pad-right;
            padding-bottom: Layout.pad-bottom;
            spacing: Layout.gap;
            Details { horizontal-stretch: 1; water: root.water; pane-width: root.details-w; }
            BrewPanel {
                width: root.panel-w;
                water: root.water;
                busy: root.busy;
            }
        }
        if Layout.stack: VerticalLayout {
            vertical-stretch: 1;
            padding-left: Layout.pad-left;
            padding-right: Layout.pad-right;
            padding-bottom: Layout.pad-bottom;
            spacing: Layout.gap;
            Details { vertical-stretch: 1; water: root.water; pane-width: root.details-w; }
            BrewPanel { vertical-stretch: 0; water: root.water; busy: root.busy; }
        }
    }
}
