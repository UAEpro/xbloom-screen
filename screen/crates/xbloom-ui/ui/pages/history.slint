// Brew history: past brews and the selected brew's curve — side by side in landscape, the
// curve above the list when stacked.

import { Theme } from "../theme.slint";
import { Layout } from "../layout.slint";
import { AppState, Icons, HistoryRow } from "../state.slint";
import { Icon, Card, BrewChart } from "../widgets.slint";
import { Header } from "../chrome.slint";

component Row inherits Rectangle {
    in property <HistoryRow> entry;
    in property <bool> selected;
    callback clicked();
    height: Layout.compact ? 58px : 66px;
    border-radius: 14px;
    background: selected ? Theme.accent-soft : ta.pressed ? Theme.surface-2 : transparent;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 36px;
            height: 36px;
            border-radius: 18px;
            background: root.entry.success ? Theme.success-soft : Theme.warning-soft;
            Icon {
                source: root.entry.success ? Icons.coffee : Icons.alert;
                tint: root.entry.success ? Theme.success : Theme.warning;
                width: 18px;
                height: 18px;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.entry.title;
                color: Theme.text;
                font-size: Theme.fs-body;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: root.entry.when + "  ·  " + root.entry.detail;
                color: Theme.text-2;
                font-size: Theme.fs-caption;
                overflow: elide;
            }
        }
    }
    ta := TouchArea {
        clicked => {
            AppState.activity();
            root.clicked();
        }
    }
}

component BrewList inherits Card {
    Flickable {
        content-width: self.width;
        content-height: list.preferred-height;
        flicked => { AppState.activity(); }
        list := VerticalLayout {
            width: parent.width;
            padding: Layout.compact ? 6px : 8px;
            spacing: 2px;
            for h[i] in AppState.history: Row {
                entry: h;
                selected: i == AppState.history-selected;
                clicked => { AppState.select-history(i); }
            }
        }
    }
}

component BrewDetail inherits Card {
    VerticalLayout {
        padding: Layout.card-pad;
        spacing: Layout.compact ? 6px : 12px;
        Text {
            text: AppState.history-title;
            color: Theme.text;
            font-size: Theme.fs-h2;
            font-weight: 700;
            overflow: elide;
        }
        Text {
            text: AppState.history-detail;
            color: Theme.text-2;
            font-size: Theme.fs-small;
            wrap: Layout.short ? no-wrap : word-wrap;
            overflow: elide;
        }
        BrewChart {
            vertical-stretch: 1;
            water: AppState.history-water;
            coffee: AppState.history-coffee;
            show-target: false;
        }
    }
}

export component HistoryPage inherits Rectangle {
    VerticalLayout {
        Header {
            title: "History";
            subtitle: AppState.history.length == 0 ? "No brews yet" : AppState.history.length + " brews";
        }
        if AppState.history.length == 0: Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                padding-left: Layout.pad-left;
                padding-right: Layout.pad-right;
                spacing: 10px;
                Icon { x: (parent.width - self.width) / 2; source: Icons.history; tint: Theme.text-3; width: 44px; height: 44px; }
                Text {
                    text: "Your brews will show up here, with their water and coffee curves.";
                    color: Theme.text-2;
                    font-size: Theme.fs-body;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
        // Placed by hand: a scrolling list would cap a layout's height at its content.
        if AppState.history.length > 0: Rectangle {
            vertical-stretch: 1;
            property <length> w: self.width - Layout.pad-left - Layout.pad-right;
            property <length> h: self.height - Layout.pad-bottom;
            property <length> list-w: clamp(w * 0.42, 180px, 360px);
            property <length> detail-h: clamp(h * 0.5, 170px, 440px);
            BrewList {
                x: Layout.pad-left;
                y: Layout.stack ? detail-h + Layout.gap : 0;
                width: Layout.stack ? w : list-w;
                height: Layout.stack ? h - detail-h - Layout.gap : h;
            }
            BrewDetail {
                x: Layout.stack ? Layout.pad-left : Layout.pad-left + list-w + Layout.gap;
                y: 0;
                width: Layout.stack ? w : w - list-w - Layout.gap;
                height: Layout.stack ? detail-h : h;
            }
        }
    }
}
